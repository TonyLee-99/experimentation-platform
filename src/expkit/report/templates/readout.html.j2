<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Experiment readout — {{ cfg.name }}</title>
<style>
  .viz-root { --surface:#fcfcfb; --ink:#0b0b0b; --ink2:#52514e; --line:#e4e3df;
              --good:#008300; --warn:#a86b00; --bad:#c62828; }
  body { margin:0; background:#f4f3f0; }
  .viz-root { font: 14px/1.45 -apple-system, "Segoe UI", Helvetica, Arial, sans-serif; color:var(--ink);
              max-width: 1040px; margin: 24px auto; padding: 0 20px; }
  .card { background:var(--surface); border:1px solid var(--line); border-radius:8px; padding:16px 20px; margin:14px 0; }
  h1 { font-size:22px; margin:0 0 4px; } h2 { font-size:16px; margin:0 0 10px; }
  .muted { color:var(--ink2); }
  .banner { border-radius:8px; padding:12px 16px; margin:12px 0; font-weight:600; border:1px solid; }
  .ok { background:#eef7ee; border-color:#b9dcb9; } .ok::before { content:"✔ "; color:var(--good); }
  .block { background:#fdecec; border-color:#f0b4b4; } .block::before { content:"✖ "; color:var(--bad); }
  .warnb { background:#fff6e5; border-color:#f0d39a; } .warnb::before { content:"⚠ "; color:var(--warn); }
  table { border-collapse:collapse; width:100%; font-variant-numeric: tabular-nums; }
  th, td { text-align:right; padding:6px 8px; border-bottom:1px solid var(--line); }
  th:first-child, td:first-child, th.l, td.l { text-align:left; }
  th { color:var(--ink2); font-weight:600; font-size:12px; }
  .verdict { font-size:26px; font-weight:700; }
  .pill { display:inline-block; padding:2px 8px; border-radius:10px; font-size:12px; font-weight:600; border:1px solid var(--line); }
  .pass { color:var(--good); } .fail { color:var(--bad); } .inconclusive { color:var(--warn); }
  code { background:#efeee9; padding:1px 4px; border-radius:4px; }
  img { max-width:100%; }
  .note { white-space: pre-line; }
</style>
</head>
<body>
<div class="viz-root">
  <h1>Experiment readout — {{ cfg.name }}</h1>
  <div class="muted">{{ cfg.description }}</div>
  <div class="muted">Control n = {{ "{:,.0f}".format(r.n.control) }} · Treatment n = {{ "{:,.0f}".format(r.n.treatment) }} · α = {{ cfg.decision.alpha }} · primary metric: <b>{{ cfg.primary_metric }}</b> · generated by <code>expkit analyze</code></div>
  {% for n in r.notes %}<div class="banner warnb">{{ n }}</div>{% endfor %}

  <section id="srm">
  {% if r.srm.blocked %}
  <div class="banner block">SRM DETECTED — observed split {{ "%.4f"|format(r.srm.observed_share[0]) }} / {{ "%.4f"|format(r.srm.observed_share[1]) }} vs expected {{ "%.4f"|format(r.srm.expected_share[0]) }} / {{ "%.4f"|format(r.srm.expected_share[1]) }} (χ² = {{ "%.1f"|format(r.srm.chi2) }}, p = {{ r.srm.p_value|p }}). All results below are untrustworthy.</div>
  {% else %}
  <div class="banner ok">No sample ratio mismatch — observed split {{ "%.5f"|format(r.srm.observed_share[0]) }} / {{ "%.5f"|format(r.srm.observed_share[1]) }} vs expected {{ "%.2f"|format(r.srm.expected_share[0]) }} / {{ "%.2f"|format(r.srm.expected_share[1]) }} (χ² = {{ "%.2g"|format(r.srm.chi2) }}, p = {{ "%.3f"|format(r.srm.p_value) }}; threshold 0.0005).</div>
  {% endif %}
  </section>

  <section id="balance">
  {% if r.balance %}
    {% if r.decision.rule == "R1b" %}<div class="banner block">Balance check FAILED — {{ r.decision.reason }}</div>
    {% elif r.balance.p_value < cfg.decision.balance_p_threshold %}<div class="banner warnb">Balance check failed (χ² = {{ "{:,.0f}".format(r.balance.chi2) }}, {{ r.balance.df }} df).</div>
    {% else %}<div class="banner ok">Covariates balanced (χ² = {{ "%.1f"|format(r.balance.chi2) }}, {{ r.balance.df }} df, p = {{ r.balance.p_value|p }}).</div>{% endif %}
  {% endif %}
  </section>

  <section id="decision" class="card">
    <h2>Recommendation</h2>
    <div class="verdict">{{ r.decision.verdict }}</div>
    <div>Rule <b>{{ r.decision.rule }}</b>: {{ r.decision.reason }}</div>
    <div class="muted" style="margin-top:6px">What a naive dashboard would have said: <b>{{ r.naive.verdict }}</b> ({{ r.naive.text }}; {{ cfg.primary_metric }} {{ r.naive.estimate.rel_lift|pct }} at the end).</div>
    {% if cfg.pm_note %}<div class="card note"><b>Note to the PM.</b> {{ cfg.pm_note }}</div>{% endif %}
    <details><summary class="muted">Decision framework (rules evaluated in order)</summary>
      <ol>
        <li>R1 SRM p &lt; 0.0005 → BLOCKED</li>
        <li>R1b pre-treatment balance fails (p &lt; {{ cfg.decision.balance_p_threshold }}) → HOLD (effect size not identified)</li>
        <li>R2 guardrail significantly worse than its margin → NO-SHIP</li>
        <li>R3 guardrail not proven within margin → HOLD</li>
        <li>R4 primary metric BH-significant and positive → SHIP</li>
        <li>R5 primary metric BH-significant and negative → NO-SHIP</li>
        <li>R6 otherwise → NO-SHIP (no evidence)</li>
      </ol>
    </details>
  </section>

  <section id="robustness" class="card">
    <h2>Decision under each estimator ({{ cfg.primary_metric }})</h2>
    <table>
      <tr><th class="l">estimator</th><th>relative lift</th><th>95% CI</th><th>p</th><th class="l">R4–R6 verdict if gates were waived</th><th class="l">note</th></tr>
      {% for x in r.robustness %}
      <tr><td>{{ x.estimator }}</td><td>{{ x.rel_lift|pct(1) }}</td><td>[{{ x.rel_ci[0]|pct(1) }}, {{ x.rel_ci[1]|pct(1) }}]</td><td>{{ x.p|p }}</td><td class="l">{{ x.verdict_if_gates_waived }}</td><td class="l muted">{{ x.note }}</td></tr>
      {% endfor %}
    </table>
    <div class="muted">If every row gives the same verdict, the <i>direction</i> is robust even when the <i>magnitude</i> is not.</div>
  </section>

  <section id="metrics" class="card">
    <h2>Metrics</h2>
    <table>
      <tr><th class="l">metric</th><th class="l">role</th><th class="l">estimator</th><th>control</th><th>treatment</th><th>relative lift</th><th>95% CI (relative)</th><th>p</th><th>BH q</th><th>variance reduction</th></tr>
      {% for row in r.rows %}
        {% set e = row.raw %}
        <tr><td>{{ row.metric }}</td><td class="l">{{ row.role }}</td><td class="l">{{ e.method }} (raw)</td>
            <td>{{ e.control|num }}</td><td>{{ e.treatment|num }}</td>
            <td>{{ e.rel_lift|pct }}</td><td>[{{ e.rel_ci_low|pct }}, {{ e.rel_ci_high|pct }}]</td><td>{{ e.p_value|p }}</td><td>{% if not row.adjusted %}{{ row.q|p }}{% endif %}</td><td></td></tr>
        {% if row.adjusted %}{% set a = row.adjusted %}
        <tr><td>{{ row.metric }}</td><td class="l">{{ row.role }}</td><td class="l"><b>{{ a.method }}</b></td>
            <td>{{ a.control|num }}</td><td>{{ a.treatment|num }}</td>
            <td><b>{{ a.rel_lift|pct }}</b></td><td>[{{ a.rel_ci_low|pct }}, {{ a.rel_ci_high|pct }}]</td><td>{{ a.p_value|p }}</td><td>{{ row.q|p }}</td><td>{{ "%.1f%%"|format(100*row.vr) }}</td></tr>
        {% endif %}
        {% for k, a in row.others.items() %}
        <tr class="muted"><td>{{ row.metric }}</td><td class="l">{{ row.role }}</td><td class="l">{{ a.method }}</td>
            <td>{{ a.control|num }}</td><td>{{ a.treatment|num }}</td>
            <td>{{ a.rel_lift|pct }}</td><td>[{{ a.rel_ci_low|pct }}, {{ a.rel_ci_high|pct }}]</td><td>{{ a.p_value|p }}</td><td></td><td>{% if k.startswith('cuped[') and k[6:-1] in row.vr_compare %}{{ "%.1f%%"|format(100*row.vr_compare[k[6:-1]]) }}{% endif %}</td></tr>
        {% endfor %}
      {% endfor %}
    </table>
    <div class="muted">Normal-approximation check (n per arm &gt; 355·skewness², Kohavi et al. 2014; else Poisson bootstrap):
      {% for row in r.rows %}{{ row.metric }}: {% if row.clt.skew is not none %}skew {{ "%.1f"|format(row.clt.skew) }}, need n &gt; {{ "{:,.0f}".format(row.clt.required_n) }}, have {{ "{:,.0f}".format(row.clt.n_min) }} → {{ "OK" if row.clt.ok else "BOOTSTRAP" }}{% else %}OK{% endif %}{% if not loop.last %}; {% endif %}{% endfor %}.
      BH q-values across primary + secondary on the decision estimate (bold).</div>
  </section>

  <section id="guardrails" class="card">
    <h2>Guardrails (non-inferiority)</h2>
    {% if r.guardrails %}
    <table>
      <tr><th class="l">guardrail</th><th>control</th><th>treatment</th><th>relative change</th><th>95% CI</th><th>margin</th><th class="l">status</th></tr>
      {% for g in r.guardrails %}
      <tr><td>{{ g.metric }} <span class="muted">({{ g.estimate.method }})</span></td><td>{{ g.estimate.control|num }}</td><td>{{ g.estimate.treatment|num }}</td>
          <td>{{ g.estimate.rel_lift|pct }}</td><td>[{{ g.estimate.rel_ci_low|pct }}, {{ g.estimate.rel_ci_high|pct }}]</td>
          <td>−{{ "%.1f%%"|format(100*g.margin) }}</td><td class="l"><span class="pill {{ g.status }}">{{ g.status.upper() }}</span></td></tr>
      {% endfor %}
    </table>
    {% else %}
    <div class="muted">This dataset has no harm metric (no opt-outs, ad frequency, complaints or latency), so no guardrail can be evaluated. The cost side is covered by the break-even table below.</div>
    {% endif %}
    {% if r.diagnostics %}
    <h2 style="margin-top:12px">Diagnostics (shown, never decisive)</h2>
    <table>
      <tr><th class="l">metric</th><th>control</th><th>treatment</th><th>relative change</th><th>95% CI</th><th class="l">why it is not a guardrail</th></tr>
      {% for d in r.diagnostics %}
      <tr><td>{{ d.metric }} <span class="muted">({{ d.method }})</span></td><td>{{ d.control|num }}</td><td>{{ d.treatment|num }}</td><td>{{ d.rel_lift|pct }}</td><td>[{{ d.rel_ci_low|pct }}, {{ d.rel_ci_high|pct }}]</td>
          <td class="l muted">its denominator (visits) is moved by the treatment, so it is a mix-shift ratio; also unadjusted</td></tr>
      {% endfor %}
    </table>
    {% endif %}
  </section>

  {% if r.economics %}{% set eco = r.economics %}
  <section id="economics" class="card">
    <h2>Economics — break-even at assumed prices</h2>
    <div>Compliance (treated users actually exposed): <b>{{ "%.2f%%"|format(100*eco.compliance) }}</b>. Incremental {{ cfg.primary_metric }}s per exposed user (decision estimate ÷ compliance): <b>{{ "%.2f"|format(100*eco.cace) }} pp</b> ± {{ "%.2f"|format(196*eco.cace_se) }} (up to {{ "%.2f"|format(100*eco.cace_sensitivity_high) }} pp under the sampling sensitivity), i.e. about <b>{{ "%.0f"|format(eco.exposed_users_per_incremental) }}</b> exposed users per incremental {{ cfg.primary_metric }}.</div>
    <table style="margin-top:8px">
      <tr><th class="l">value per {{ cfg.primary_metric }}</th>{% for c in eco.costs %}<th>cost ${{ "%.2f"|format(c) }} / exposed user</th>{% endfor %}</tr>
      {% for row in eco.grid %}
      <tr><td>${{ "%.0f"|format(row.value_per_conversion) }}</td>{% for c in row.cells %}<td>iROAS {{ "%.2f"|format(c.iroas) }} <span class="muted">({{ c.verdict }})</span></td>{% endfor %}</tr>
      {% endfor %}
    </table>
    <div class="muted">{{ eco.note }}</div>
  </section>
  {% endif %}

  <section id="bayes" class="card">
    <h2>Bayesian expected loss</h2>
    {% if r.bayes_informative %}
    <table>
      <tr><th class="l">quantity</th><th>value</th></tr>
      <tr><td>posterior mean of Δ ({{ cfg.primary_metric }}, prior N(0, ({{ "%.2f%%"|format(100*cfg.decision.prior_sd_relative) }} of baseline)²))</td><td>{{ r.bayes.post_mean|num }}</td></tr>
      <tr><td>P(true effect &gt; 0)</td><td>{{ "%.3f"|format(r.bayes.prob_positive) }}</td></tr>
      <tr><td>expected loss if we ship  E[max(−θ,0)]</td><td>{{ r.bayes.loss_ship|num(3) }}</td></tr>
      <tr><td>expected loss if we don't ship  E[max(θ,0)]</td><td>{{ r.bayes.loss_hold|num(3) }}</td></tr>
      <tr><td>threshold ε ({{ "%.2f%%"|format(100*cfg.decision.loss_threshold_relative) }} of baseline)</td><td>{{ r.bayes.threshold|num(3) }}</td></tr>
      <tr><td><b>expected-loss rule</b> (ship if loss_ship &lt; ε)</td><td><b>{{ r.bayes.verdict }}</b></td></tr>
    </table>
    <div>{% if (r.decision.verdict == 'SHIP') == r.bayes.ship %}The expected-loss rule <b>agrees</b> with the framework.{% else %}The expected-loss rule <b>disagrees</b> with the framework ({{ r.decision.verdict }} vs {{ r.bayes.verdict }}). The framework asks "is it proven better and safe?"; the loss rule asks "is the expected downside below ε?". When ε is comparable to the SE, the loss rule ships changes whose sign is still uncertain.{% endif %}</div>
    {% else %}
    <div class="muted">N/A — the decision is not close: P(true effect &gt; 0) = {{ "%.4f"|format(r.bayes.prob_positive) }} and the expected loss of {{ "shipping" if r.bayes.post_mean > 0 else "not shipping" }} is ≈ 0, so this panel cannot change the call.</div>
    {% endif %}
  </section>

  <section id="sequential" class="card">
    <h2>Sequential monitoring — {{ cfg.primary_metric }}</h2>
    {% if r.sequential_png %}
    <img alt="Sequential boundary chart: |z| path vs O'Brien-Fleming and mSPRT boundaries" src="data:image/png;base64,{{ r.sequential_png }}">
    {% if 'first_day_naive' in r.sequential_summary %}
    <table>
      <tr><th class="l">method</th><th>first crossing</th></tr>
      <tr><td>naive |z| ≥ 1.96 every day (inflates false positives)</td><td>{{ ("day %g"|format(r.sequential_summary.first_day_naive)) if r.sequential_summary.first_day_naive else "never" }}</td></tr>
      <tr><td>O'Brien-Fleming (Lan-DeMets, variance-based information)</td><td>{{ ("day %g"|format(r.sequential_summary.first_day_obf)) if r.sequential_summary.first_day_obf else "never" }}</td></tr>
      <tr><td>mSPRT (τ = {{ "%.2f%%"|format(100*r.sequential_summary.tau_relative) }} of baseline)</td><td>{{ ("day %g"|format(r.sequential_summary.first_day_msprt)) if r.sequential_summary.first_day_msprt else "never" }}</td></tr>
    </table>
    {% endif %}
    <div class="muted">{{ r.sequential_summary.label }}.</div>
    {% else %}
    <div class="muted">{{ r.sequential_summary.reason }}</div>
    {% endif %}
  </section>

  {% if r.balance %}
  <section id="balance-detail" class="card">
    <h2>Covariate balance detail (standardized mean differences)</h2>
    <table><tr>{% for k in r.balance.smd %}<th>{{ k }}</th>{% endfor %}</tr>
      <tr>{% for k, v in r.balance.smd.items() %}<td>{{ "%+.3f"|format(v) }}</td>{% endfor %}</tr></table>
  </section>
  {% endif %}
</div>
</body>
</html>
